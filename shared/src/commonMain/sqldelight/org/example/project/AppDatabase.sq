CREATE TABLE User (
    name TEXT NOT NULL,
    state TEXT NOT NULL,
    mobileNumber TEXT NOT NULL PRIMARY KEY
);

insertUser:
INSERT OR REPLACE INTO User (name, state, mobileNumber)
VALUES (?, ?, ?);

getUserByMobile:
SELECT * FROM User WHERE mobileNumber = ?;

selectAllUsers:
SELECT * FROM User;

-- Metadata Tables
CREATE TABLE VehicleType (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE
);

CREATE TABLE Brand (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE
);

CREATE TABLE Model (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    brandName TEXT NOT NULL,
    name TEXT NOT NULL
);

CREATE TABLE FuelType (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE
);

CREATE TABLE GearType (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE
);

CREATE TABLE IF NOT EXISTS VehicleColor (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE
);

CREATE TABLE IF NOT EXISTS VehicleCategory (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE
);

CREATE TABLE IF NOT EXISTS SeatingCapacity (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE
);

-- User Vehicle Table
CREATE TABLE UserVehicle (
    registrationNumber TEXT NOT NULL PRIMARY KEY,
    vehicleType TEXT NOT NULL,
    brand TEXT NOT NULL,
    model TEXT NOT NULL,
    year INTEGER NOT NULL,
    fuelType TEXT NOT NULL,
    gearType TEXT NOT NULL,
    imageRes TEXT NOT NULL,
    userMobile TEXT NOT NULL
);

-- Metadata Queries
insertVehicleType:
INSERT OR IGNORE INTO VehicleType (name) VALUES (?);

insertBrand:
INSERT OR IGNORE INTO Brand (name) VALUES (?);

insertModel:
INSERT OR REPLACE INTO Model (brandName, name) VALUES (?, ?);

insertFuelType:
INSERT OR IGNORE INTO FuelType (name) VALUES (?);

insertGearType:
INSERT OR IGNORE INTO GearType (name) VALUES (?);

insertVehicleColor:
INSERT OR IGNORE INTO VehicleColor (name) VALUES (?);

insertVehicleCategory:
INSERT OR IGNORE INTO VehicleCategory (name) VALUES (?);

insertSeatingCapacity:
INSERT OR IGNORE INTO SeatingCapacity (name) VALUES (?);

selectVehicleTypes:
SELECT name FROM VehicleType;

selectBrands:
SELECT name FROM Brand;

selectModelsByBrand:
SELECT name FROM Model WHERE brandName = ?;

selectFuelTypes:
SELECT name FROM FuelType;

selectGearTypes:
SELECT name FROM GearType;

selectVehicleColors:
SELECT name FROM VehicleColor;

selectVehicleCategories:
SELECT name FROM VehicleCategory;

selectSeatingCapacities:
SELECT name FROM SeatingCapacity;

-- User Vehicle Queries
insertUserVehicle:
INSERT OR REPLACE INTO UserVehicle (
    registrationNumber, vehicleType, brand, model, year, fuelType, gearType, imageRes, userMobile
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectUserVehicles:
SELECT * FROM UserVehicle WHERE userMobile = ?;

deleteUserVehicle:
DELETE FROM UserVehicle WHERE registrationNumber = ?;

createCountryTable:
CREATE TABLE IF NOT EXISTS CountryEntity (
    isoCode TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    flag TEXT NOT NULL,
    dialCode TEXT NOT NULL
);

insertCountry:
INSERT OR REPLACE INTO CountryEntity (isoCode, name, flag, dialCode)
VALUES (?, ?, ?, ?);

selectAllCountries:
SELECT * FROM CountryEntity ORDER BY name ASC;

deleteAllCountries:
DELETE FROM CountryEntity;
